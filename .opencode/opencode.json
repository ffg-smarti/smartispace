{
  "$schema": "https://opencode.ai/config.json",
  
    "mcp": {
        "filesystem": {
            "type": "local",
            "enabled": true,
            "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "/home/wawassik/smartispace/smartispace/"]
        },
        "sqlite": {
            "type": "local",
            "enabled": true,
            "command": ["npx", "-y", "mcp-sqlite", "/home/wawassik/smartispace/smartispace/backend/src/smarti/db.sqlite3"]            
        },
        "postgres": {
            "type": "local",
            "enabled": true,
            "command": ["npx", "-y", "mcp-postgres-server"],
            "environment": {
                "PG_HOST": "localhost",
                "PG_PORT": "5432",
                "PG_USER": "wawassik",
                "PG_DATABASE": "smarti"
            }
        },
        "django": {
            "type": "local",
            "enabled": true,
            "command": ["uv", "run", "python", "-m", "mcp_django", "--settings=dweb.dsmarti.settings"],
            "environment": {
                "DJANGO_SETTINGS_MODULE": "dweb.dsmarti.settings"
            }
        },
        "playwright": {
            "type": "local",
            "enabled": true,
            "command": ["npx", "-y", "@playwright/mcp"]
        },
        "backend-mcp": {
            "type": "local",
            "enabled": true,
            "command": ["uv", "run", "python", "-m", "tools.mcp.backend"],
            "environment": {
                "PYTHONPATH": "/home/wawassik/smartispace/smartispace/backend/src",
                "DJANGO_SETTINGS_MODULE": "dweb.smarti.settings"
            }
        },
        "ffg-mcp": {
            "type": "local",
            "enabled": true,
            "command": ["uv", "run", "python", "-m", "tools.mcp.frontend"],
            "environment": {
                "PYTHONPATH": "/home/wawassik/smartispace/smartispace/backend/src",
                "FRONTEND_DIR": "/home/wawassik/smartispace/smartispace/apps/kids",
                "MCP_PORT": "8081",
                "MCP_NAME": "ffg-mcp"
            }
        },
        "smarti-mcp": {
            "type": "local",
            "enabled": true,
            "command": ["uv", "run", "python", "-m", "tools.mcp.frontend"],
            "environment": {
                "PYTHONPATH": "/home/wawassik/smartispace/smartispace/backend/src",
                "FRONTEND_DIR": "/home/wawassik/smartispace/smartispace/apps/parent",
                "MCP_PORT": "8080",
                "MCP_NAME": "smarti-mcp"
            }
        }
    },
    "skills": {
        "paths": [".opencode/skills"]
    },
    "references": {
        "design": {
            "path": "../docs/design",
            "description": "Use for architecture/design decisions (Doc 1-8)"
        },
        "shared-context": {
            "path": "./shared",
            "description": "Use for cross-cutting architecture principles"
        }
    }
}
