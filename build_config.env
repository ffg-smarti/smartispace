# build_config.env – Umgebungsvariablen fuer psmarti
# Diese Datei wird automatisch von psmarti geladen.
# Anpassungen werden erst nach einem Neustart von psmarti wirksam.

# GitHub Owner / Organisation (wird von `psmarti demo clone` und `start` benoetigt)
GH_OWNER=ffg-smarti

# SSH-Host aus ~/.ssh/config (z.B. github.com oder github-ffg-smarti)
# Falls nicht gesetzt, wird standardmaessig github.com verwendet.
GH_SSH_HOST=github-ffg-smarti

# Secrets (Passphrase etc.) in secrets.env auslagern (wird von .gitignore ignoriert)
